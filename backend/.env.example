# AgriPulse AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git!

# ── Google Gemini API Keys (3-key rotation) ───────────────────────────────────
# The backend tries KEY_1 first, then KEY_2, then KEY_3.
# If one quota is exhausted/expired, the next is used automatically.
# Get FREE keys at: https://aistudio.google.com/app/apikey
#
# Free-tier limits:
#   Quota  : 15 requests/minute, 1500 requests/day per key (resets daily at midnight UTC)
#   Expiry : Keys themselves do not expire unless you delete them in AI Studio
#
GEMINI_API_KEY_1=paste_your_key_here
GEMINI_API_KEY_2=paste_your_key_here
GEMINI_API_KEY_3=paste_your_key_here

